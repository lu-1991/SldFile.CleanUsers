<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <TargetFramework>net8.0</TargetFramework>
        <LangVersion>latest</LangVersion>
        <Nullable>enable</Nullable>
        <RootNamespace>SldFile.CleanUsers</RootNamespace>
        <AssemblyName>SldFile.CleanUsers</AssemblyName>
        <InvariantGlobalization>true</InvariantGlobalization>
        <Description>Removes recorded user names and author metadata from SolidWorks files (SLDPRT, SLDASM, SLDDRW).</Description>
    </PropertyGroup>

    <ItemGroup>
        <ProjectReference Include="..\SldFile\SldFile.csproj" />
    </ItemGroup>

</Project>
