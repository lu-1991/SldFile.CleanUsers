<Project Sdk="Microsoft.NET.Sdk">

    <!-- Core parser: reads SolidWorks containers and writes back sanitized streams. -->
    <PropertyGroup>
        <TargetFramework>netstandard2.0</TargetFramework>
        <LangVersion>latest</LangVersion>
        <Nullable>enable</Nullable>
        <RootNamespace>SldFile</RootNamespace>
        <Description>SolidWorks 文件解析与写回核心库（用户信息清理工具使用）</Description>
    </PropertyGroup>

    <ItemGroup>
        <InternalsVisibleTo Include="SldFile.CleanUsers" />
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="OpenMcdf" Version="3.1.4" />
        <PackageReference Include="System.Memory" Version="4.6.3" />
    </ItemGroup>

</Project>
